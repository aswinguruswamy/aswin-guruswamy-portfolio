---
// EXPLAIN: status badge with the small shuttlecock (D22). LIVE = first version out (D23).
import type { Status } from '../lib/content';
import Shuttle from './Shuttle.astro';
interface Props { status: Status }
const { status } = Astro.props;
const cls = status === 'Live' ? 'live' : status === 'In progress' ? 'progress' : 'planned';
---
<span class={`badge ${cls}`}>
  <Shuttle />
  {status}
</span>
