---
// EXPLAIN: brand logos, drawn at build time from icon packages (no image files, no outside requests).
// GitHub: GitHub's own Octicons mark. Tools: Simple Icons. LinkedIn: the "in" mark (Font Awesome brands).
import * as si from 'simple-icons';
import octicons from '@primer/octicons';
import { faLinkedinIn } from '@fortawesome/free-brands-svg-icons';
interface Props { name: string; size?: number }
const { name, size = 18 } = Astro.props;
let viewBox = '0 0 24 24';
let d = '';
if (name === 'GitHub') {
  const o = octicons['mark-github'].heights['24'];
  viewBox = `0 0 ${o.width} 24`;
  d = o.path.match(/ d="([^"]+)"/)?.[1] ?? '';
} else if (name === 'LinkedIn') {
  const [w, h, , , p] = faLinkedinIn.icon;
  viewBox = `0 0 ${w} ${h}`;
  d = Array.isArray(p) ? p.join(' ') : p;
} else {
  const icon = (si as Record<string, { title: string; path: string }>)['si' + name.replace(/[^A-Za-z]/g, '')];
  d = icon?.path ?? '';
}
---
{d && <svg class="icon" width={size} height={size} viewBox={viewBox} aria-hidden="true" focusable="false"><path fill="currentColor" d={d} /></svg>}
