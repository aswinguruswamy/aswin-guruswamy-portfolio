---
// EXPLAIN: one page for each project that has real content (problem, approach, role, stack, outcome, links).
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Shuttle from '../../components/Shuttle.astro';
import SuiteTabs from '../../components/SuiteTabs.astro';
import { SUITE } from '../../lib/suite';
import { withPage, pmTools, type Project } from '../../lib/content';
export async function getStaticPaths() {
  return withPage.map((p, i) => ({ params: { slug: p.slug }, props: { p, prev: withPage[i - 1], next: withPage[i + 1] } }));
}
interface Props { p: Project; prev?: Project; next?: Project }
const { p, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isPm = pmTools.includes(p);
const group = isPm ? 'PM tools' : 'Apps and simulations';
const sec = isPm ? 'pm-tools' : 'apps';
const pg = p.page!;
const inSuite = SUITE.some(([s]) => s === p.slug);
const boxes: [string, string][] = [['PROBLEM', pg.problem], ['APPROACH', pg.approach], ['MY ROLE', pg.role], ['STACK', pg.stack], ['OUTCOME', pg.outcome]];
---
<Base title={`${p.name} · Aswin Guruswamy`} description={`${p.name}: ${p.line}.`} section={sec} heading="">
  <div class="crumbs-row">
    <div class="crumbs">
      <a class="btn" href={`${base}/#${sec}`}><span class="arr" aria-hidden="true">←</span><span>All {group}</span></a>
      <small>{group} › {p.name}</small>
    </div>
  </div>
  {inSuite && <SuiteTabs current={p.slug} />}
  <section class="panel">
    <div class="p-hero">
      <div class="shot">{p.image
        ? <img src={`${base}/img/${p.image}`} alt={`Screenshot of ${p.name}`} decoding="async" />
        : <span class="soon"><Shuttle size={64} /><span>{p.status === 'Live' ? 'No screenshot yet' : 'Coming soon'}</span></span>}</div>
      <div>
        <h1 class="display">{p.name.toUpperCase()}</h1>
        <p>{p.line}</p>
        <div class="p-meta"><Badge status={p.status} />{p.version && <span class="ver">{p.version}</span>}</div>
        <button class="btn primary" type="button" data-copy-link>Copy link to this page</button>
      </div>
    </div>
  </section>
  <div class="p-grid">
    {boxes.map(([h, t]) => (
      <section class="panel"><div class="panel-head"><h2 class="tag">{h}</h2></div><p>{t}</p></section>
    ))}
    {p.links?.length ? <section class="panel"><div class="panel-head"><h2 class="tag">LINKS</h2></div>
      <div class="p-links">{(p.links ?? []).map((l) => <a class="btn" href={l.href} target="_blank" rel="noopener noreferrer"><span>{l.label}<span class="vh"> (opens in a new tab)</span></span><span class="arr" aria-hidden="true">↗</span></a>)}</div>
    </section> : null}
  </div>
  <nav class="pager" aria-label="Other projects">
    {prev ? <a class="btn prev" href={`${base}/projects/${prev.slug}/`}><span class="arr" aria-hidden="true">←</span><span>{prev.name}</span></a> : <span></span>}
    {next ? <a class="btn next" href={`${base}/projects/${next.slug}/`}><span>{next.name}</span><span class="arr" aria-hidden="true">→</span></a> : <span></span>}
  </nav>
</Base>
