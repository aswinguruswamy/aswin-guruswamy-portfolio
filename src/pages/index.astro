---
// EXPLAIN: the main page. The order follows the recruiter view (D22): who, contact, projects, experience, skills.
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import Tile from '../components/Tile.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import { profile, pmTools, apps, experience, skills, allProjects } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const live = allProjects.filter((p) => p.status === 'Live').length;
const hasResume = fs.existsSync(new URL('../../public/resume.pdf', import.meta.url));
---
<Base title={`${profile.name} · ${profile.title}`} description={`${profile.name}, ${profile.title} (PMP, CSM, CSPO), ${profile.location}. PM tools built with AI, experience and skills.`} heading="Overview" person>
  <div class="grid">
    <!-- EXPLAIN: invisible container for the intro, Projects and Career goal (D42 v0). Wide screen: the same 4-column line as before.
         Under 1100 px: one sideways row with ‹ › buttons, intro first. -->
    <div class="top-nav span4"><span class="row-nav" data-row="top-row"><button class="arrow-btn" type="button" data-dir="-1" aria-controls="top-row" aria-label="Scroll intro, projects and career goal left">‹</button><button class="arrow-btn" type="button" data-dir="1" aria-controls="top-row" aria-label="Scroll intro, projects and career goal right">›</button></span></div>
    <div class="top-row span4" id="top-row">
    <section class="panel span2 hero" id="overview" aria-label="About Aswin">
      <div class="hero-id">
        <span class="av-wrap">
          <Avatar id="hero" size={128} />
          <svg class="racket" width="54" height="54" viewBox="0 0 120 120" aria-hidden="true"><ellipse cx="78" cy="38" rx="26" ry="32" class="rk-head" stroke-width="6" transform="rotate(35 78 38)"/><path d="M62 22 L94 54 M70 16 L100 46 M56 30 L86 62 M66 50 L90 26 M58 42 L82 18" class="rk-line" stroke-width="2.5"/><path d="M58 62 L22 104" class="rk-line" stroke-width="9" stroke-linecap="round"/></svg>
        </span>
        <div>
          <h1 class="display">{profile.name.toUpperCase()}</h1>
          <div class="role">{profile.title}</div>
          <div class="where">{profile.location}</div>
        </div>
      </div>
      <ul class="chips" aria-label="Credentials">{profile.badges.map((b) => <li>{b}</li>)}</ul>
      <p class="summary">{profile.summary}</p>
      <div class="hero-actions">
        <button class="btn primary" type="button" data-u={profile.emailUser} data-d={profile.emailDomain}>Copy email</button>
        {hasResume
          ? <a class="btn" href={`${base}/resume.pdf`} download>Download résumé</a>
          : <span class="btn" aria-disabled="true">Résumé soon</span>}
        <p class="copy-out" hidden></p>
      </div>
    </section>

    <section class="panel" aria-labelledby="h-projects">
      <div class="panel-head"><h2 class="tag" id="h-projects">PROJECTS</h2></div>
      <div class="stat">
        <span class="big display">{allProjects.length}</span>
        <ul>
          <li>{pmTools.length} PM tools</li>
          <li>{apps.length} apps</li>
          <li>{live} live <Badge status="Live" /></li>
        </ul>
      </div>
    </section>

    <section class="panel" aria-labelledby="h-goal">
      <div class="panel-head"><h2 class="tag" id="h-goal">CAREER GOAL</h2></div>
      <ul class="ladder" aria-label="Career ladder, from now (bottom) up to the goal (top)">
        {profile.ladder.map((step, i) => (
          <>
            <li>
              <span class={`step${i === profile.ladder.length - 1 ? ' now' : ''}`}>{step}</span>
              {i === 0 && <span class="goal">goal</span>}
              {i === profile.ladder.length - 1 && <span class="vh"> (now)</span>}
            </li>
            {i < profile.ladder.length - 1 && <li class="arrow" aria-hidden="true">↑</li>}
          </>
        ))}
      </ul>
    </section>

    </div>

    <section class="panel span4" id="pm-tools" aria-labelledby="h-tools">
      <div class="panel-head"><h2 class="tag" id="h-tools">PM TOOLS</h2><span class="count">{pmTools.length} tools</span><span class="row-nav" data-row="tools-row"><button class="arrow-btn" type="button" data-dir="-1" aria-controls="tools-row" aria-label="Scroll PM tools left">‹</button><button class="arrow-btn" type="button" data-dir="1" aria-controls="tools-row" aria-label="Scroll PM tools right">›</button></span></div>
      <ul class="row clip" id="tools-row">{pmTools.map((p) => <Tile p={p} />)}</ul>
      <button class="more" type="button" aria-controls="tools-row">Show all {pmTools.length} PM tools ↓</button>
    </section>

    <div class="split">
      <section class="panel" id="apps" aria-labelledby="h-apps">
        <div class="panel-head"><h2 class="tag" id="h-apps">APPS AND SIMULATIONS</h2><span class="count">{apps.length} apps</span><span class="row-nav" data-row="apps-row"><button class="arrow-btn" type="button" data-dir="-1" aria-controls="apps-row" aria-label="Scroll apps left">‹</button><button class="arrow-btn" type="button" data-dir="1" aria-controls="apps-row" aria-label="Scroll apps right">›</button></span></div>
        <ul class="row" id="apps-row">{apps.map((p) => <Tile p={p} />)}</ul>
      </section>
      <section class="panel" id="experience" aria-labelledby="h-exp">
        <div class="panel-head"><h2 class="tag" id="h-exp">EXPERIENCE</h2></div>
        <div class="boxes">{experience.map((e) => <div class="box"><strong>{e.org}</strong><span>{e.role}</span><p>{e.text}</p></div>)}</div>
      </section>
    </div>

    <section class="panel span4" id="skills" aria-labelledby="h-skills">
      <div class="panel-head"><h2 class="tag" id="h-skills">SKILLS</h2></div>
      <div class="skills">
        {skills.map((s, i) => (
          <details open={i === 0}>
            <summary><span>{s.head}</span><span class="chev" aria-hidden="true">▸</span></summary>
            {s.tools
              ? <ul class="tools">{s.tools.map((t) => <li><Icon name={t} size={20} />{t}</li>)}</ul>
              : <p>{s.text}</p>}
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>
