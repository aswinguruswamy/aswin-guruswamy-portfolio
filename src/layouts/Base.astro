---
import Shuttle from '../components/Shuttle.astro';
// EXPLAIN: the frame of every page: head tags, sidebar (desktop) or menu (phone), top bar, footer.
import '@fontsource/bangers/400.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '../styles/global.css';
import fs from 'node:fs';
import Avatar from '../components/Avatar.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../lib/content';

interface Props { title: string; description: string; section?: string; heading: string; person?: boolean; wip?: boolean }
const { title, description, section = 'overview', heading, person = false, wip = false } = Astro.props;
// EXPLAIN: a new version tag on each build, so a browser never keeps an old script with a new page (issue 12).
const v = (process.env.GITHUB_SHA || String(Date.now())).slice(0, 8);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${import.meta.env.BASE_URL}og.png`, Astro.site).href;
// EXPLAIN: Person structured data (REQ-21) helps search engines show the right name, title and profiles.
const personLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: profile.name, jobTitle: profile.title, address: { '@type': 'PostalAddress', addressRegion: 'Ontario', addressCountry: 'CA' }, url: new URL(import.meta.env.BASE_URL, Astro.site).href, image: ogImage, sameAs: [profile.linkedin, profile.github], hasCredential: ['PMP', 'CSM', 'CSPO'].map((n) => ({ '@type': 'EducationalOccupationalCredential', name: n })) });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
// EXPLAIN: the résumé button becomes a real download as soon as public/resume.pdf exists.
const hasResume = fs.existsSync(new URL('../../public/resume.pdf', import.meta.url));
const nav = [
  ['overview', 'Overview', '#overview'],
  ['pm-tools', 'PM tools', '#pm-tools'],
  ['apps', 'Apps and simulations', '#apps'],
  ['experience', 'Experience', '#experience'],
  ['skills', 'Skills', '#skills'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aswin Guruswamy, Project Manager: PMP, CSM, CSPO. Greater Toronto Area, Canada." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    {person && <script type="application/ld+json" set:html={personLd} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline src={`${base}/js/theme.js?v=${v}`}></script>
  </head>
  <body>
    <a class="vh" href="#main">Skip to content</a>
    <div class="shell">
      <aside class="side" id="menu" aria-label="Sections">
        <div class="panel-head">
          <a class="brand" href={home}>
            <Avatar id="side" size={44} label={false} />
            <span><strong class="display">{profile.name.toUpperCase()}</strong><small>Portfolio</small></span>
          </a>
          <button class="close menu-close" type="button" aria-label="Close menu">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5 L19 19 M19 5 L5 19" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
          </button>
        </div>
        <nav class="nav">
          {nav.map(([id, label, hash]) => (
            <a href={section === 'overview' ? hash : `${home}${hash}`} aria-current={id === section ? 'true' : undefined}><span>{label}</span></a>
          ))}
        </nav>
        <div class="actions">
          <button class="btn primary" type="button" data-u={profile.emailUser} data-d={profile.emailDomain}>Copy email</button>
          <p class="copy-out" hidden></p>
          {hasResume
            ? <a class="btn" href={`${base}/resume.pdf`} download>Download résumé</a>
            : <span class="btn" aria-disabled="true">Résumé coming soon</span>}
        </div>
      </aside>
      <main id="main">
        <header class="top">
          <button class="menu-btn" type="button" aria-label="Open menu" aria-controls="menu" aria-expanded="false">
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6 H21 M3 12 H21 M3 18 H21" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
          </button>
          <span class="title display">{wip
            ? <button class="wip" type="button" data-workshop data-base={base} aria-pressed="false" aria-label="View Build Progress" title="Show the build progress (Workshop)"><Shuttle size={16} /><span><span class="wip-view">View </span>Build Progress</span></button>
            : heading}</span>
          <div class="links">
            <a class="btn social" href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)"><Icon name="LinkedIn" /><span class="lbl">LinkedIn</span></a>
            <a class="btn social" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)"><Icon name="GitHub" /><span class="lbl">GitHub</span></a>
            <button class="btn theme" type="button" aria-label="Light / dark mode"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 3 A9 9 0 0 1 12 21 Z" fill="currentColor"/></svg><span> Light / dark</span></button>
          </div>
        </header>
        <slot />
        <p id="status" class="sr-only" role="status" aria-live="polite"></p>
        <footer>© {new Date().getFullYear()} {profile.name} · Built with Claude, run as a PM project</footer>
      </main>
    </div>
    <script is:inline src={`${base}/js/site.js?v=${v}`} defer></script>
    {wip && <script is:inline defer src={`${base}/js/workshop.js?v=${v}`}></script>}
  </body>
</html>
